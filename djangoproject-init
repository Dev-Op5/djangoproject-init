#!/usr/bin/env bash
set -euo pipefail

# ==============================================
# djangoproject-init
# Bootstrap Django development project
#
# scripted with ❤️ by eRQee (q@serverq.org)
# ==============================================

SCRIPT_NAME="$(basename "$0")"
DEFAULT_DJANGO_MAJOR=6
DRY_RUN=false
WORKSPACE_DIR=workspace

TIMESTAMP="$(date '+%Y-%m-%d %H:%M:%S')"
LOG_FILE="1nfra/logs/bash_history.log"

print_help() {
cat << 'EOF'
djangoproject-init — bootstrap Django development project

Usage:
  djangoproject-init [TARGET_DIR] --version=[VERSION] [--dry-run | --help]

Arguments:
  TARGET_DIR     Optional target directory:
                 - folder   -> create & use folder
                 - .        -> use current directory
                 - (none)   -> use default "new.djangoproject" folder

  VERSION        Optional Django version selector:
                 - 6        -> Django >=6.0,<7.0
                 - 6.0      -> Django >=6.0,<6.1
                 - (none)   -> Django >=6.0,<7.0 (default)


Options:
  --dry-run      Print actions without executing
  --help         Show this help message
  --self-update  Update the script to the latest version


Examples:
  djangoproject-init
  djangoproject-init <directory>
  djangoproject-init <directory> --version=6.0

  djangoproject-init --dry-run     # to show the command which will be executed (no changes made)
  djangoproject-init --help        # to show this help
EOF
}

run() {
    if [[ "$DRY_RUN" == true ]]; then
        echo "[dry-run] $*"
    else
        eval "$@"
        echo "$@" >> "$LOG_FILE"
    fi
}

self_update() {
    TMP_FILE="$(mktemp)"
    trap 'rm -f "$TMP_FILE"' EXIT

    mkdir -p "$HOME/.local/bin"

    run "curl -fsSL https://raw.githubusercontent.com/Dev-Op5/djangoproject-init/refs/heads/master/djangoproject-init -o \"$TMP_FILE\""
    run "chmod +x \"$TMP_FILE\""

    read -r CHECKSUM_DOWNLOADED _ < <(sha1sum "$TMP_FILE")

    if [[ -f "$HOME/.local/bin/djangoproject-init" ]]; then
        read -r CHECKSUM_EXISTING _ < <(sha1sum "$HOME/.local/bin/djangoproject-init")
    else
        CHECKSUM_EXISTING=""
    fi

    if [[ -n "$CHECKSUM_EXISTING" ]]; then
        if [[ "$CHECKSUM_DOWNLOADED" == "$CHECKSUM_EXISTING" ]]; then
            echo "Already up to date."
            exit 0
        fi
        run "rm \"$HOME/.local/bin/djangoproject-init\""
    else
        echo "Installing djangoproject-init to $HOME/.local/bin/"
    fi

    run "mv \"$TMP_FILE\" \"$HOME/.local/bin/djangoproject-init\""
    echo "UPDATE SUCCESSFULLY!"
    exit 0
}

# -------------------------
# Argument parsing
# -------------------------
DEFAULT_VERSION="6.0"
DEFAULT_DIR="new.djangoproject"

TARGET_DIR=""
DJANGO_VERSION="$DEFAULT_VERSION"

for arg in "$@"; do
    case "$arg" in
        --help)
            print_help
            exit 0
            ;;
        --dry-run)
            DRY_RUN=true
            ;;
        --version=*)
            DJANGO_VERSION="${arg#*=}"
            ;;
        --self-update)
            self_update
            exit 0
            ;;
        -*)
            echo "❌ Unknown option: $arg"
            exit 2
            ;;
        *)
            if [[ -z "$TARGET_DIR" ]]; then
                TARGET_DIR="$arg"
            else
                echo "❌ Too many arguments"
                exit 2
            fi
            ;;
    esac
done

# defaults
if [[ -z "$TARGET_DIR" ]]; then
    TARGET_DIR="$DEFAULT_DIR"
fi


# -------------------------
# Django version resolution
# -------------------------
if [[ -z "$DJANGO_VERSION" ]]; then
    DJANGO_SPEC="Django>=${DEFAULT_DJANGO_MAJOR}.0,<$((${DEFAULT_DJANGO_MAJOR}+1)).0"
elif [[ "$DJANGO_VERSION" =~ ^[0-9]+$ ]]; then
    DJANGO_SPEC="Django>=${DJANGO_VERSION}.0,<$((${DJANGO_VERSION}+1)).0"
elif [[ "$DJANGO_VERSION" =~ ^[0-9]+\.[0-9]+$ ]]; then
    MAJOR="${DJANGO_VERSION%%.*}"
    MINOR="${DJANGO_VERSION##*.}"
    DJANGO_SPEC="Django>=${MAJOR}.${MINOR},<${MAJOR}.$((MINOR+1))"
else
    echo "❌ Invalid Django version: $DJANGO_VERSION"
    exit 2
fi

echo "==> Using $DJANGO_SPEC"

# -------------------------
# Target directory handling
# -------------------------
echo "==> Target directory : $TARGET_DIR"
echo "==> Django version   : $DJANGO_VERSION"

if [[ "$TARGET_DIR" == "." ]]; then
    if [[ -n "$(ls -A . 2>/dev/null)" ]]; then
        echo "❌ Current directory is not empty"
        exit 3
    fi
elif [[ "$TARGET_DIR" == "help" ]]; then
    print_help
    exit 0
elif [[ "$TARGET_DIR" == "self-update" ]]; then
    self_update
    exit 3
else
    if [[ -e "$TARGET_DIR" ]]; then
        echo "❌ Directory already exists: $TARGET_DIR"
        exit 3
    fi
    mkdir -p "$TARGET_DIR"
    cd "$TARGET_DIR"
fi


# -------------------------
# Bootstrap process
# -------------------------
if [[ "$DRY_RUN" == false ]]; then
    mkdir -p 1nfra/logs
    {
        echo "======================================================================"
        echo " djangoproject-init run at [$TIMESTAMP]"
        echo "======================================================================"
    } >> "$LOG_FILE"
fi


run "mkdir -p 1nfra/{backup,certs,env} concepts theming/{static,static.collect,template-overrides} uploads utils"
run "touch 1nfra/certs/.gitkeep 1nfra/env/.gitkeep 1nfra/logs/.gitkeep concepts/.gitkeep theming/static/.gitkeep theming/static.collect/.gitkeep theming/template-overrides/.gitkeep uploads/.gitkeep utils/.gitkeep"

run "python -m venv .venv"

UTILS_DIR="$(realpath utils)"

run "curl -fsSL https://raw.githubusercontent.com/Dev-Op5/djangoproject-init/refs/heads/master/manage -o /tmp/manage"
run "chmod +x /tmp/manage"
run "mv /tmp/manage \"$UTILS_DIR\"/manage"
run "ln -rs \"$UTILS_DIR\"/manage .venv/bin/manage"

run "curl -fsSL https://raw.githubusercontent.com/Dev-Op5/pg-execute/master/pg-execute -o /tmp/pg-execute"
run "chmod +x /tmp/pg-execute"
run "mv /tmp/pg-execute \"$UTILS_DIR\"/pg-execute"
run "ln -rs \"$UTILS_DIR\"/pg-execute .venv/bin/pg-execute"

run "source .venv/bin/activate"
run "python -m pip install --upgrade pip"
run "python -m pip install \"$DJANGO_SPEC\" django-stubs django-stubs-ext python-decouple gunicorn"
run "python -m pip freeze > requirements.txt"

# Defaults file
# Create backup/restore configuration file
run "cat > 1nfra/backup/db.conf.example << EOL
db_host = localhost
db_port = 5432
db_user = postgres
db_pass = changeme
db_name = yourdatabasename
EOL"

run "cat > 1nfra/backup/README.md << EOL
This Backup/Restore (specific to PostgreSQL) operates using the CLI 'pg-execute'. Available on your 'utils' folder.

Source: https://github.com/Dev-Op5/pg-execute/

CLI usage test example:
1. Run the command: 'pg-execute generate-config' to generate the db.conf file.
2. Adjust the connection variables in the db.conf file based on your DB settings.
3. In the 'backup' folder, test by running the command: 'pg-execute login'

If you can enter the psql console, then it works!
EOL"

# Create template for nginx reverse proxy
if [[ "$DRY_RUN" == true ]]; then
run "echo 'create nginx reverse proxy configuration template in 1nfra/nginx-example.local.conf'"
else

cat > 1nfra/nginx-example.local.conf << 'EOL'
server {
  listen                     80;
  server_name                example.local;
  return 301                 https://$server_name$request_uri;
}

server {
  listen                     443 ssl;
  http2                      on;
  server_name                example.local;

EOL

CURRENT_DIR=$(pwd)
cat >> 1nfra/nginx-example.local.conf << EOL
  root                       ${CURRENT_DIR};
  access_log                 ${CURRENT_DIR}/1nfra/logs/access.log gzip;
  error_log                  ${CURRENT_DIR}/1nfra/logs/error.log notice;

  ssl_certificate            ${CURRENT_DIR}/1nfra/certs/example.local.pem;
  ssl_certificate_key        ${CURRENT_DIR}/server.conf/certs/example.local-key.pem;

EOL

cat >> 1nfra/nginx-example.local.conf << 'EOL'
  include                    /etc/nginx/snippets/ssl-params.conf;
  include                    /etc/nginx/snippets/headers.conf;

  location / {
    proxy_pass               http://127.0.0.1:8000;
    error_page               502 = /502.html;
    proxy_set_header         Host $host;
    proxy_set_header         X-Real-IP $remote_addr;
    proxy_set_header         X-Forwarded-For $proxy_add_x_forwarded_for;
    proxy_set_header         X-Forwarded-Proto $scheme;
    send_timeout             60;
    client_max_body_size     100M;
    client_body_buffer_size  100M;
  }
}
EOL

fi

# Repo-level gitignore
run "cat > .gitignore << 'EOL'
.env
.venv/
/1nfra/backup/db.conf
/1nfra/backup/*.7z
/1nfra/certs/*
!/1nfra/certs/.gitkeep
/1nfra/env/*
!/1nfra/env/env.example
/1nfra/logs/*.log
!/1nfra/logs/.gitkeep
/1nfra/*.conf
/theming/static.collect/
!/theming/static.collect/.gitkeep
/uploads/*
!/uploads/.gitkeep
*.log
.DS_Store
Thumbs.db
*.sublime-project
.sublime-workspace
.zed/
EOL"

# Django project
run ".venv/bin/django-admin startproject $WORKSPACE_DIR"
run "mv $WORKSPACE_DIR src"

# Project-level gitignore
run "cat > src/.gitignore << 'EOL'
__pycache__/
*.py[cod]
db.sqlite3
*.log
.vscode/
.idea/
.zed/
.coverage
*.sublime-project
.sublime-workspace
htmlcov/
.pytest_cache/
mypy.ini
pyproject.toml
pyrightconfig.json
EOL"

# default .env.example
run "cat > src/.env.example << 'EOL'
APP_DEBUG=False
APP_SECRET_KEY=changeme

APP_FRONTEND_SITE_URL=https://127.0.0.1:8000

DB_NAME=databasename
DB_USER=databaseuser
DB_PASSWORD=databasepassword
DB_HOST=127.0.0.1
DB_PORT=5432

UNOSEND_ACCOUNT=your@email.com
UNOSEND_API_KEY=un_r4nd0mstr1n6fR0muNosenD
UNOSEND_FROM_EMAIL=no-reply@yourdomain.tld

GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=

EOL"

cp src/.env.example 1nfra/env/env.example

# Template Dockerfile
run "cat > Dockerfile << 'EOL'
#
# Suggested image name: django-$TARGET_DIR:latest
#
FROM python:3.13-slim

ENV PYTHONDONTWRITEBYTECODE=1
ENV PYTHONUNBUFFERED=1

RUN apt-get update && apt-get install -y  \\
    libpq-dev \\
    gcc \\
    libcairo2 \\
    libcairo2-dev \\
    libpango-1.0-0 \\
    libpangocairo-1.0-0 \\
    libgdk-pixbuf-2.0-0 \\
    nano \\
    tree \\
    && rm -rf /var/lib/apt/lists/*

WORKDIR /app

ENV PYTHONPATH=/app/src
ENV PATH=\"/app/utils:\${PATH}\"

RUN mkdir -p /app/logs

# === install deps ===
COPY requirements.txt /app/
RUN pip install --no-cache-dir -r requirements.txt

# === Django project ===
COPY src /app/src
COPY theming /app/theming
COPY uploads /app/uploads
COPY utils /app/utils

# === Command ===
CMD [\"gunicorn\", \"src.workspace.wsgi:application\", \"--bind\", \"0.0.0.0:8000\", \"--workers\", \"2\"]

EOL"

# Template docker-compose.yml
run "cat > docker-compose.yml << 'EOL'
services:
  django:
    image: django-$TARGET_DIR:latest
    container_name: django-$TARGET_DIR
    env_file:
      - ./1nfra/env/env.example
    volumes:
      - ./1nfra/logs:/app/logs
      - ./theming/static.collect:/app/theming/static.collect
      - ./uploads:/app/uploads
    network_mode: host
    restart: unless-stopped
EOL"

# Tooling config
run "cat > src/pyproject.toml << 'EOL'
[tool.black]
line-length = 88
target-version = ['py313']

[tool.isort]
profile = 'black'
line_length = 88
EOL"

run "cat > src/.flake8 << 'EOL'
[flake8]
max-line-length = 88
extend-ignore = E203, W503
exclude = .git,__pycache__,.env,.venv
EOL"

run "cat > src/pyrightconfig.json << 'EOL'
{
  \"pythonVersion\": \"3.13\",
  \"pythonPlatform\": \"Linux\",
  \"typeCheckingMode\": \"standard\",
  \"reportGeneralTypeIssues\": \"warning\",
  \"reportAttributeAccessIssue\": \"warning\",
  \"reportIncompatibleVariableOverride\": false,
  \"reportUnknownMemberType\": false,
  \"reportUnknownVariableType\": false,
  \"useLibraryCodeForTypes\": true,
  \"venvPath\": \".\",
  \"venv\": \".venv\",
  \"exclude\": [
    \"**/migrations\",
    \"**/__pycache__\",
    \"backup\",
    \"logs\",
    \"server.conf\",
    \"spec\",
    \"uploads\",
    \"utils\"
  ]
}
EOL"

run "cat > src/mypy.ini << 'EOL'
[mypy]
python_version = 3.13
plugins = mypy_django_plugin.main
ignore_missing_imports = true

[mypy.plugins.django-stubs]
django_settings_module = workspace.settings
EOL"

run "cat > README.md << 'EOL'
#  Now you're ready to craft an awesome Django application! ❤️
==========================================================================

## Dev Tips

1. Always activate the python virtual environment by run this command once in every coding session you've initiated:

   \`source .venv/bin/activate\`

2. Use the \`manage\` command to run everything that \`python3 manage.py\` did.
   Also, use the \`manage\` command to run pip installation, eg: \`manage pip install some-python-package\`.

   > ✅ By using that, you'll have a command forensic which you can review at \`1nfra/logs/bash_history.log\`

3. In order to make LSP-pyright more intelligent, adjust this file: \`src/$WORKSPACE_DIR/settings.py\`

   a) add these lines in the import declaration:

   \`\`\`
      import django_stubs_ext
      django_stubs_ext.monkeypatch()
   \`\`\`

   b) in \`INSTALLED_APPS\` ⇒ add: \`\"django_stubs_ext\"\`

4. ⚠️  If you plan to use a custom User model, define it BEFORE the first migrate.

5. Also run this: \`manage toc\` -- to see the things can do with those **django command gateway for artisan**


EOL"

# Git init
run "git init"
run "git add utils"
run "git commit -m '[init] BASH utils: manage and pg-execute'"
run "git add -f 1nfra/nginx-example.local.conf"
run "git commit -m '[init] example of nginx configuration'"
run "git add requirements.txt"
run "git commit -m '[init] requirements.txt'"
run "git add .gitignore src/.gitignore"
run "git commit -m '[init] .gitignore rules'"
run "git add ."
run "git commit -m '[init] Django project structure'"
echo "✅ Django project initialized successfully."

if [[ "$DRY_RUN" == false ]]; then
    echo "======================================================================" >> "$LOG_FILE"
    echo "✅ Django project initialized successfully." >> "$LOG_FILE"
    echo "======================================================================" >> "$LOG_FILE"
    echo "" >> "$LOG_FILE"
    echo ""
    echo "================================================================================"
    echo "NEXT STEPS, execute these command below inside your newly created '$TARGET_DIR' directory"
    echo "================================================================================"
    echo ""
    echo "  cd \"$TARGET_DIR\""
    echo "  source .venv/bin/activate"
    echo "  cd workspaces"
    echo "  manage git remote add origin <your git repository address>"
    echo "  manage git push"
    echo ""
    echo "================================================================================"
fi
